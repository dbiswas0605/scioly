# Copy to `.env` (same directory as docker-compose.prod.yml) and fill in
# the values marked below. See DEPLOY.md for the full walkthrough.

# --- Postgres ---
POSTGRES_USER=scioly
POSTGRES_PASSWORD=change-me-to-something-real
POSTGRES_DB=scioly
POSTGRES_PORT=5433

# REQUIRED: a real path on the host to persist the database to — ideally an
# external/USB drive mounted on the Pi, not the SD card. Must already exist.
# Example: /mnt/ssd/scioly-postgres-data
POSTGRES_DATA_DIR=/mnt/ssd/scioly-postgres-data

# --- Backend ---
BACKEND_PORT=8000

# REQUIRED: where browsers will load the frontend from — used for CORS.
# Example: http://192.168.1.50:3000 (your Pi's LAN IP) or http://scioly.local:3000
CORS_ORIGINS=http://192.168.1.50:3000

# --- Frontend ---
FRONTEND_PORT=3000

# REQUIRED: where browsers will reach the backend from — baked into the
# frontend at build time, so this must be set correctly *before* building.
# Example: http://192.168.1.50:8000
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.50:8000
